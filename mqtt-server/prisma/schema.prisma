generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Tabel Pengguna Web
model User {
  id       Int      @id @default(autoincrement())
  nama     String
  email    String   @unique
  password String
  role     String   @default("VIEWER")
}

// Tabel Alat ESP yang Terhubung
model EspDevice {
  id            Int      @id @default(autoincrement())
  identitas     String   @unique 
  namaAlat      String           
  terakhirAktif DateTime @default(now()) 
  
  data          AltimeterData[]
}

// Tabel Data Sensor
model AltimeterData {
  id          Int      @id @default(autoincrement())
  tekanan     Float
  ketinggian  Float
  createdAt   DateTime @default(now())

  espId       Int
  esp         EspDevice @relation(fields: [espId], references: [id])
}